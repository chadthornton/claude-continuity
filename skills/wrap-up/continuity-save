#!/bin/bash
# continuity-save — make .continuity/ durable at the end of a wrap-up.
#
# Commits ONLY .continuity/ (never code, never last-activity.txt). If the project
# opts in (feature-status.yml: `settings: { push_to_default_branch: true }`),
# also lands those commits on origin/<default> WITHOUT shipping any code the
# current branch carries: each continuity-only commit is re-applied onto
# origin/<default> with a three-way `git merge-tree`, stamped with a
# `Continuity-Source: <sha>` trailer, and pushed as a fast-forward. Never forces.
#
#   continuity-save [-m "message"]
#   continuity-save --resolve [-m "message"]
#
# --resolve is the way out of a CONFLICT: after you have hand-merged (start from
# `git restore --source=origin/<default> -- .continuity`, re-apply this
# session's edits), it lands this checkout's .continuity/ AS-IS on
# origin/<default> and stamps every pending commit as landed. It trusts that
# your .continuity/ already includes what origin has — that's the hand merge.
#
# Prints one status line (plus notes). Exit codes:
#   0  saved (or nothing to save, or saved locally by design)
#   1  could not reach the remote / push kept being rejected — committed locally only
#   2  conflict with a newer .continuity on origin — nothing pushed, needs a human
#   3  not usable here (not a git repo, no .continuity/, git too old)

set -u
MSG="continuity: wrap-up"
RESOLVE=0
if [ "${1:-}" = "--resolve" ]; then RESOLVE=1; shift; fi
while getopts "m:" opt; do
  case $opt in
    m) MSG="$OPTARG" ;;
    *) echo "usage: continuity-save [-m message]" >&2; exit 3 ;;
  esac
done

. "$(cd "$(dirname "$0")/../.." && pwd)/lib/continuity-commits.sh" || { echo "FAILED: lib/continuity-commits.sh missing"; exit 3; }
EXCL=$CC_EXCL
AWAYX=$CC_AWAYX   # /away's brief rides on the branch only

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "SKIP: not a git repository"; exit 3; }
cd "$(git rev-parse --show-toplevel)" || exit 3
[ -d .continuity ] || { echo "SKIP: no .continuity/ here"; exit 3; }
if git check-ignore -q .continuity/feature-status.yml; then
  echo "SKIP: .continuity/ is gitignored in this project — nothing to make durable"
  exit 0
fi

BRANCH=$(git symbolic-ref --short -q HEAD || echo "(detached)")

# 1. Commit only .continuity/ — `git commit -- <paths>` leaves anything else
#    the user has staged exactly as it was.
git add -A -- .continuity "$EXCL" "$AWAYX"
if ! git diff --cached --quiet -- .continuity "$EXCL" "$AWAYX"; then
  git commit -q -m "$MSG" -- .continuity "$EXCL" "$AWAYX" || { echo "FAILED: git commit"; exit 3; }
fi

# 2. Where should it live?
if ! git remote | grep -qx origin; then
  echo "SAVED LOCALLY: $(git rev-parse --short HEAD) on $BRANCH (no origin remote)"
  exit 0
fi
D_REF=$(cc_default_ref) \
  || { echo "SAVED LOCALLY on $BRANCH: can't tell origin's default branch (run: git remote set-head origin -a)"; exit 1; }
D=${D_REF#origin/}

if ! grep -Eq '^[[:space:]]*push_to_default_branch:[[:space:]]*true' .continuity/feature-status.yml; then
  if git merge-base --is-ancestor HEAD "$D_REF" 2>/dev/null; then
    echo "SAVED: $(git rev-parse --short HEAD) on $BRANCH (already on $D_REF)"
  else
    echo "SAVED ON BRANCH ONLY: $(git rev-parse --short HEAD) on $BRANCH — not on $D_REF until this branch merges."
    echo "  Opt in to auto-landing: add 'settings: { push_to_default_branch: true }' to .continuity/feature-status.yml"
  fi
  exit 0
fi

# 3. Land continuity-only commits on origin/<default>.
git merge-tree --write-tree --merge-base HEAD HEAD HEAD >/dev/null 2>&1 \
  || { echo "SAVED LOCALLY on $BRANCH: git $(git --version | awk '{print $3}') lacks 'merge-tree --merge-base' (needs 2.40+)"; exit 3; }

attempt() {
  git fetch -q origin "$D" 2>/dev/null || { echo "SAVED LOCALLY on $BRANCH: fetch of origin/$D failed — not pushed"; return 1; }
  local pending c base tree out msg kind scan
  # lib/continuity-commits.sh decides what's landed, a sync, a merge, mixed or
  # pending; mixed commits (code or away.md with continuity) never get pushed.
  scan=$(cc_scan "$D_REF" "$D_REF..HEAD")
  pending=$(printf '%s\n' "$scan" | awk '$2 == "pending" { printf " %s", $1 }')
  SKIPPED=$(printf '%s\n' "$scan" | awk '$2 == "mixed" { printf " %s", substr($1, 1, 7) }')
  [ -n "$SKIPPED" ] && echo "  NOTE: skipped commits that mix code with .continuity/ (merge the branch to land them):$SKIPPED"
  if [ -z "$pending" ]; then
    echo "SAVED: nothing new to land — $D_REF already has this branch's continuity"
    return 0
  fi

  base=$(git rev-parse "$D_REF")
  if [ $RESOLVE -eq 1 ]; then
    # Graft HEAD's .continuity/ onto origin's tree in a throwaway index —
    # the working tree and the real index are never touched.
    local idx trailers=""
    idx="$(git rev-parse --git-dir)/continuity-resolve-index.$$"
    GIT_INDEX_FILE="$idx" git read-tree "$D_REF" \
      && GIT_INDEX_FILE="$idx" git rm -r -q -f --cached --ignore-unmatch .continuity \
      && GIT_INDEX_FILE="$idx" git read-tree --prefix=.continuity/ "HEAD:.continuity" \
      && GIT_INDEX_FILE="$idx" git rm -q --cached --ignore-unmatch .continuity/away.md \
      && tree=$(GIT_INDEX_FILE="$idx" git write-tree)
    rc=$?; rm -f "$idx"
    [ $rc -eq 0 ] || { echo "FAILED: could not build the resolve tree"; return 2; }
    for c in $pending; do trailers="${trailers}Continuity-Source: $c
"; done
    base=$(printf '%s\n\n%s' "$MSG (resolved onto $D)" "$trailers" | git commit-tree "$tree" -p "$base")
    pending=""
  fi
  for c in $pending; do
    out=$(git merge-tree --write-tree --merge-base "$c^" "$base" "$c" 2>&1)
    if [ $? -ne 0 ]; then
      echo "CONFLICT: ${c:0:7} vs newer .continuity on $D_REF — nothing pushed. Committed on $BRANCH."
      printf '%s\n' "$out" | sed -n '2,8p' | sed 's/^/  /'
      echo "  Fix: git restore --source=$D_REF -- .continuity, re-apply this session's edits, then: continuity-save --resolve"
      return 2
    fi
    tree=$(printf '%s\n' "$out" | head -1)
    msg=$(git log -1 --format=%B "$c")
    base=$(printf '%s\n\nContinuity-Source: %s\n' "$msg" "$c" | git commit-tree "$tree" -p "$base")
  done

  if git diff --name-only "$D_REF" "$base" | grep -qv '^\.continuity/'; then
    echo "ABORTED: built commit touches paths outside .continuity/ — refusing to push"; return 2
  fi
  if git push -q origin "$base:refs/heads/$D" 2>/dev/null; then
    echo "SAVED: $(git rev-parse --short "$base") landed on $D_REF (from $BRANCH)"
    if [ "$BRANCH" = "$D" ]; then
      if [ -z "$(git rev-list "$D_REF..HEAD" -- . ":(exclude).continuity")" ] 2>/dev/null; then
        git fetch -q origin "$D" && git reset -q --keep "$D_REF" \
          && echo "  local $D fast-forwarded to $D_REF"
      else
        echo "  NOTE: local $D also has unpushed code commits — 'git pull --rebase' before pushing them"
      fi
    fi
    return 0
  fi
  return 10   # rejected (origin moved) — caller retries once
}

# sync_branch — after a clean land from a feature branch, make the branch's
# .continuity/ equal origin/<default>'s (which now holds this branch's edits
# too). Otherwise the branch keeps its own copy of the board, and once another
# session moves the board on the default branch the branch's PR conflicts on it.
# Skipped when a mixed commit was held back: its .continuity edits aren't on
# origin, and adopting origin's copy would drop them from this checkout.
sync_branch() {
  [ "$BRANCH" = "$D" ] || [ "$BRANCH" = "(detached)" ] || [ -n "$SKIPPED" ] && return 0
  # While /away's brief is on the branch, /back replays the cloud's commits onto
  # this branch; a sync here would widen that replay and invite conflicts.
  git cat-file -e HEAD:.continuity/away.md 2>/dev/null && return 0
  git diff --quiet "$D_REF" HEAD -- .continuity "$EXCL" "$AWAYX" && return 0
  git restore --source="$D_REF" --staged --worktree -- .continuity "$EXCL" "$AWAYX" 2>/dev/null || return 0
  git diff --cached --quiet -- .continuity && return 0
  git commit -q -m "continuity: sync with $D_REF" -m "Continuity-Sync: $(git rev-parse "$D_REF")" \
    -- .continuity "$EXCL" "$AWAYX" || return 0
  echo "  synced $BRANCH's .continuity/ with $D_REF — keeps its PR clear of continuity conflicts"
}

attempt; rc=$?
if [ $rc -eq 10 ]; then attempt; rc=$?; fi
if [ $rc -eq 10 ]; then echo "SAVED LOCALLY on $BRANCH: push to origin/$D rejected twice — not pushed (protected branch?)"; exit 1; fi
[ $rc -eq 0 ] && sync_branch
exit $rc
