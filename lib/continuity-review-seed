#!/bin/bash
# continuity-review-seed — the one document the review page reads.
#
#   continuity-review-seed <review.json> <audit.json> <project name> [--notes <overrides.json>]
#   continuity-review-seed --live <seed.json> <audit.json>   refresh what's running
#
# Merges the audit's facts with the reviewer's judgments, per initiative, and
# prints one JSON document for the page's store (review/current). The review
# must pass continuity-review-check against the same audit, or nothing is
# printed and the problems go to stderr (exit 1).
#
# Per initiative, `judged` names every field that is Claude's judgment, so the
# page can mark it: an area, size or aspiration the reader confirmed on the
# board (the board holds it and `inferred` does not list it) is a fact; one the
# board lacks, or lists as inferred, is the reviewer's. line, points, recent,
# progress, proposal and suggest are always judgments.
#
# --notes takes the page's overrides as the review read them (one object keyed
# by row) and records each row's note under notes_read, so that on "go" the
# notes this review read can be cleared and any written since kept.
#
#
# --live takes a seed already on the page and a fresh audit and prints it with
# only the running sessions refreshed (each initiative's running and
# running_idle, the sessions list, live_at); generated and every judgment stay,
# so a round sent from this review still matches it. An audit that couldn't see
# sessions changes nothing.
#
# Exit codes: 0 ok · 1 the review fails the checker · 3 not usable here
set -u
LIB="$(cd "$(dirname "$0")" && pwd)"
command -v jq >/dev/null 2>&1 || { echo "SKIP: continuity-review-seed needs jq" >&2; exit 3; }
if [ "${1:-}" = "--live" ]; then
  [ $# -eq 3 ] && jq -e . "$2" >/dev/null 2>&1 && jq -e . "$3" >/dev/null 2>&1 || { echo "usage: continuity-review-seed --live <seed.json> <audit.json>" >&2; exit 3; }
  if [ "$(jq -r '.sessions.source // "unavailable"' "$3")" = unavailable ]; then
    echo "live not refreshed: the audit could not see sessions (unavailable)" >&2; jq . "$2"; exit 0
  fi
  jq --slurpfile a "$3" '($a[0].sessions.items // []) as $sess
    | .initiatives |= map(.row as $r | ([$sess[] | select(.row == $r and .running)] | .[0]) as $s
        | .running = ($s.name // null) | .running_idle = (($s.activity // "") | startswith("idle")))
    | .sessions = $sess | .live_at = (now | strftime("%Y-%m-%dT%H:%MZ"))' "$2"
  exit
fi

NOTES=/dev/null
[ $# -eq 5 ] && [ "$4" = "--notes" ] && NOTES=$5 && set -- "$1" "$2" "$3"
[ $# -eq 3 ] && [ -r "$1" ] && [ -r "$2" ] && [ -r "$NOTES" ] || { echo "usage: continuity-review-seed <review.json> <audit.json> <project name> [--notes <overrides.json>]" >&2; exit 3; }
if [ "$NOTES" != /dev/null ] && ! jq -e . "$NOTES" >/dev/null 2>&1; then
  echo "notes not recorded: $NOTES is not JSON; seeding without them" >&2; NOTES=/dev/null
fi

if ! problems=$("$LIB/continuity-review-check" "$1" "$2"); then
  printf 'not seeded: the review fails continuity-review-check\n%s\n' "$problems" >&2
  exit 1
fi

jq -n --slurpfile r "$1" --slurpfile a "$2" --slurpfile n "$NOTES" --arg project "$3" '
$r[0] as $rv | $a[0] as $au
| ($rv.initiatives | map({key: .row, value: .}) | from_entries) as $byrow
| ($au.sessions.items // []) as $sess
| [ $au.rows[] | . as $row | ($byrow[.name] // {}) as $j
    | ([$sess[] | select(.row == $row.name and .running)] | .[0]) as $s
    | reduce ("area", "size", "aspiration") as $f ({v: {}, judged: []};
        if ($row[$f] != null) and (($row.inferred // []) | index($f) | not)
        then .v[$f] = $row[$f]
        elif $j[$f] != null then .v[$f] = $j[$f] | .judged += [$f]
        elif $row[$f] != null then .v[$f] = $row[$f] | .judged += [$f]
        else .v[$f] = null end) as $m
    | {row: .name, section, status, open, done, gated,
       waiting: (.gated | length), activity, flags,
       running: ($s.name // null), running_idle: (($s.activity // "") | startswith("idle")),
       area: $m.v.area, size: $m.v.size, aspiration: $m.v.aspiration,
       progress: ($j.progress // null), progress_basis: ($j.progress_basis // null),
       line: ($j.line // null), points: ($j.points // []), recent: ($j.recent // []), proposal: ($j.proposal // null),
       suggest: ($j.suggest // null),
       judged: ($m.judged + ["line", "points", "recent", "progress", "proposal", "suggest"])}
  ] as $inits
| (if $rv.mode == "full" then [$rv.areas[] | {name, what, open_question, starters: (.starters // [])}]
   else [($au.areas // [])[] | {name, what, open_question, starters: []}] end) as $areas
| {
    project: $project, mode: $rv.mode, since: $rv.since, read: $rv.read,
    generated: (now | strftime("%Y-%m-%dT%H:%MZ")),
    board_source: $au.board.source,
    lanes: {live: 1, back: 3, quiet: 3},
    areas: [$areas[] | . as $ar | . + {initiatives: ([$inits[] | select(.area == $ar.name)] | length)}],
    initiatives: $inits,
    chore_groups: ($rv.chore_groups // []),
    sessions: $sess,
    live_at: (now | strftime("%Y-%m-%dT%H:%MZ")),
    notes_read: (($n[0] // {}) | if type == "object" then with_entries(select((.value | type) == "object" and ((.value.notes // null) | type) == "string" and (.value.notes | length) > 0) | .value = .value.notes) else {} end)
  }' "$1"
